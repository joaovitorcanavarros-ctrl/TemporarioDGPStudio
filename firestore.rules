rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "joao1canavarros@gmail.com" ||
        request.auth.token.email == "admin@cbmmt.mt.gov.br" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.perfil == "ADMIN")
      );
    }

    // Central corporate data: militares, editais, cargos, lotações e auditoria
    match /corporacao/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles and RBAC permissions
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
