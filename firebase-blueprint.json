{
  "entities": {
    "CorporacaoMetadados": {
      "title": "CorporacaoMetadados",
      "description": "Metadados leves da corporação: configurações, catálogos, usuários e histórico recente",
      "type": "object",
      "properties": {
        "config": { "type": "object" },
        "categorias": { "type": "array" },
        "cargos": { "type": "array" },
        "lotacoes": { "type": "array" },
        "editais": { "type": "array" },
        "motivos": { "type": "array" },
        "usuarios": { "type": "array" },
        "alteracoes": { "type": "array" },
        "situacoes": { "type": "array" },
        "ultima_atualizacao": { "type": "string" }
      }
    },
    "MilitarRecord": {
      "title": "MilitarRecord",
      "description": "Cadastro individual de Bombeiro Militar Temporário",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matricula": { "type": "string" },
        "nome_completo": { "type": "string" },
        "cargo_id": { "type": "string" },
        "lotacao_id": { "type": "string" },
        "edital_id": { "type": "string" },
        "data_inclusao": { "type": "string" },
        "data_vencimento_contrato": { "type": "string" },
        "status": { "type": "string", "enum": ["ATIVO", "DESLIGADO"] },
        "observacoes": { "type": "string" },
        "doe_incorporacao": { "type": "string" },
        "sub_judice": { "type": "boolean" },
        "data_desligamento": { "type": "string" },
        "motivo_desligamento_id": { "type": "string" },
        "documento_desligamento": { "type": "string" },
        "criado_em": { "type": "string" },
        "atualizado_em": { "type": "string" },
        "criado_por": { "type": "string" },
        "atualizado_por": { "type": "string" }
      },
      "required": ["id", "matricula", "nome_completo", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control and system metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID matching auth.uid" },
        "nome": { "type": "string", "description": "Full name of the user", "maxLength": 160 },
        "email": { "type": "string", "description": "Email address of the user", "maxLength": 160 },
        "perfil": { "type": "string", "enum": ["ADMIN", "GESTOR", "CONSULTA"], "description": "Access profile" },
        "ativo": { "type": "boolean", "description": "Whether the user account is active" },
        "photoURL": { "type": "string", "description": "Optional avatar URL" },
        "criado_em": { "type": "string", "description": "Account creation timestamp" }
      },
      "required": ["id", "nome", "email", "perfil", "ativo"]
    }
  },
  "firestore": {
    "/corporacao/{docId}": {
      "schema": "CorporacaoMetadados",
      "description": "Corporate metadata, catalogs, and recent logs"
    },
    "/militares/{militarId}": {
      "schema": "MilitarRecord",
      "description": "Individual military personnel records for granular reads and writes"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account and permission profiles"
    }
  }
}
