{
  "entities": {
    "CorporacaoDados": {
      "title": "CorporacaoDados",
      "description": "Dados institucionais e tabelas auxiliares da corporação: configurações, categorias, cargos, lotações/UBMs, editais e motivos de desligamento",
      "type": "object",
      "properties": {
        "config": { "type": "object" },
        "categorias": { "type": "array" },
        "cargos": { "type": "array" },
        "lotacoes": { "type": "array" },
        "editais": { "type": "array" },
        "motivos": { "type": "array" },
        "ultima_atualizacao": { "type": "string" }
      }
    },
    "MilitarRecord": {
      "title": "MilitarRecord",
      "description": "Cadastro individual de Bombeiro Militar Temporário",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "matricula": { "type": "string" },
        "nome_completo": { "type": "string" },
        "cargo_id": { "type": "string" },
        "lotacao_id": { "type": "string" },
        "edital_id": { "type": "string" },
        "data_inclusao": { "type": "string" },
        "data_vencimento_contrato": { "type": "string" },
        "status": { "type": "string", "enum": ["ATIVO", "DESLIGADO"] },
        "observacoes": { "type": "string" },
        "doe_incorporacao": { "type": "string" },
        "sub_judice": { "type": "boolean" },
        "data_desligamento": { "type": "string" },
        "motivo_desligamento_id": { "type": "string" },
        "documento_desligamento": { "type": "string" },
        "criado_em": { "type": "string" },
        "atualizado_em": { "type": "string" },
        "criado_por": { "type": "string" },
        "atualizado_por": { "type": "string" }
      },
      "required": ["id", "matricula", "nome_completo", "status"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access control and system metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID matching auth.uid" },
        "nome": { "type": "string", "description": "Full name of the user", "maxLength": 160 },
        "email": { "type": "string", "description": "Email address of the user", "maxLength": 160 },
        "perfil": { "type": "string", "enum": ["ADMIN", "GESTOR", "CONSULTA"], "description": "Access profile" },
        "ativo": { "type": "boolean", "description": "Whether the user account is active" },
        "photoURL": { "type": "string", "description": "Optional avatar URL" },
        "criado_em": { "type": "string", "description": "Account creation timestamp" }
      },
      "required": ["id", "nome", "email", "perfil", "ativo"]
    },
    "AuditoriaLog": {
      "title": "AuditoriaLog",
      "description": "Documento individual de auditoria de ações executadas no sistema",
      "type": "object",
      "properties": {
        "data_hora": { "type": "string", "description": "Timestamp do Firestore (serverTimestamp)" },
        "timestamp": { "type": "string", "description": "Data/hora ISO de referência" },
        "usuario_nome": { "type": "string", "description": "Nome do usuário logado que realizou a ação" },
        "usuario_email": { "type": "string", "description": "E-mail do autor da ação" },
        "operacao": { "type": "string", "description": "Tipo da ação executada" },
        "entidade": { "type": "string", "description": "Tipo do registro afetado" },
        "entidade_id": { "type": "string", "description": "ID ou matrícula do registro afetado" },
        "matricula": { "type": "string", "description": "Matrícula do militar afetado (se aplicável)" },
        "detalhes": { "type": "object", "description": "Objeto contendo antes e depois das alterações" }
      },
      "required": ["usuario_nome", "operacao", "entidade"]
    }
  },
  "firestore": {
    "/corporacao/{docId}": {
      "schema": "CorporacaoDados",
      "description": "Dados institucionais e tabelas auxiliares (corporacao/dados)"
    },
    "/militares/{militarId}": {
      "schema": "MilitarRecord",
      "description": "Repositório exclusivo das fichas funcionais individuais"
    },
    "/usuarios/{userId}": {
      "schema": "UserProfile",
      "description": "Controle exclusivo de permissões de acesso e perfis de usuários"
    },
    "/auditoria/{auditId}": {
      "schema": "AuditoriaLog",
      "description": "Logs individuais de alterações de sistema com serverTimestamp()"
    }
  }
}
